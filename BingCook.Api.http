@BingCook.Api_HostAddress = http://localhost:5115

POST {{BingCook.Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "fullName": "Jane Cook",
  "email": "jane@example.com",
  "phone": "+84901234567",
  "password": "Password123"
}

###

POST {{BingCook.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "identity": "jane@example.com",
  "password": "Password123"
}

###

POST {{BingCook.Api_HostAddress}}/api/auth/logout
Authorization: Bearer {{authToken}}
Accept: application/json

###

POST {{BingCook.Api_HostAddress}}/api/bookings/draft
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "propertyId": "11111111-1111-1111-1111-111111111111",
  "roomId": "21111111-1111-1111-1111-111111111111",
  "checkIn": "2026-07-10",
  "checkOut": "2026-07-13",
  "adults": 2,
  "children": 1,
  "roomQuantity": 1,
  "addOns": ["breakfast", "airport_pickup"],
  "note": "High floor if available."
}

###

POST {{BingCook.Api_HostAddress}}/api/bookings/checkout
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "bookingId": "{{bookingId}}",
  "paymentMethod": "PayAtProperty",
  "customerName": "Jane Cook",
  "customerEmail": "jane@example.com",
  "customerPhone": "+84901234567",
  "identityNumber": "012345678901"
}

###

POST {{BingCook.Api_HostAddress}}/api/bookings/checkout
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "bookingId": "{{bookingId}}",
  "paymentMethod": "PayOS",
  "customerName": "Jane Cook",
  "customerEmail": "jane@example.com",
  "customerPhone": "+84901234567"
}

###

GET {{BingCook.Api_HostAddress}}/api/bookings/{{bookingId}}/status
Authorization: Bearer {{authToken}}
Accept: application/json

###

POST {{BingCook.Api_HostAddress}}/api/bookings/{{bookingId}}/repay
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "customerName": "Jane Cook",
  "customerEmail": "jane@example.com",
  "customerPhone": "+84901234567"
}
